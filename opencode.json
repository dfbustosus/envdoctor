{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "share": "manual",
  "instructions": ["AGENTS.md"],
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "skill": {
      "*": "allow"
    }
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "coverage/**",
      ".git/**",
      ".idea/**",
      "*.tgz"
    ]
  },
  "formatter": true,
  "lsp": true,
  "compaction": {
    "auto": true,
    "prune": false,
    "reserved": 10000
  }
}
