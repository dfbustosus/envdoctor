{
  "name": "env-doctor",
  "version": "0.1.0",
  "description": "Find dotenv configuration drift, missing variables, duplicates, and exposed secret risks.",
  "type": "module",
  "license": "MIT",
  "author": "David Bustos Usta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dfbustosus/envdoctor.git"
  },
  "homepage": "https://github.com/dfbustosus/envdoctor#readme",
  "bugs": {
    "url": "https://github.com/dfbustosus/envdoctor/issues"
  },
  "keywords": [
    "dotenv",
    "env",
    "environment-variables",
    "configuration",
    "secrets",
    "cli"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "bin": {
    "env-doctor": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "ci": "npm run typecheck && npm run lint && npm test && npm audit && npm run build && npm pack --dry-run",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "lint": "eslint . --max-warnings=0",
    "pack:dry-run": "npm pack --dry-run",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@babel/parser": "^7.26.0",
    "dotenv": "^16.4.7",
    "fast-glob": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  }
}
