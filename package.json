{
  "name": "dotenv-drift",
  "version": "0.1.1",
  "description": "Find dotenv configuration drift, missing variables, duplicates, and exposed secret risks.",
  "type": "module",
  "license": "MIT",
  "author": "David Bustos Usta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dfbustosus/envdoctor.git"
  },
  "homepage": "https://github.com/dfbustosus/envdoctor#readme",
  "bugs": {
    "url": "https://github.com/dfbustosus/envdoctor/issues"
  },
  "keywords": [
    "dotenv",
    "env",
    "environment-variables",
    "configuration",
    "secrets",
    "cli"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "bin": {
    "env-doctor": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/scan-report-v1.json": "./schemas/scan-report-v1.schema.json"
  },
  "files": [
    "dist",
    "schemas",
    "CHANGELOG.md",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "ci": "npm run verify && npm run test:coverage && npm audit && npm run pack:validate",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "lint": "eslint . --max-warnings=0",
    "pack:dry-run": "npm pack --dry-run",
    "pack:validate": "node scripts/validate-packed-package.mjs",
    "prepack": "npm run build",
    "release:validate": "node scripts/validate-release.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "dotenv": "^16.4.7",
    "fast-glob": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitest/coverage-v8": "^4.1.9",
    "ajv": "^8.20.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  }
}
